# ==============================================================================
# National University AI Assistant Platform — Environment Variables
# ==============================================================================

# AI Models & Cloud API Keys (Gemini, OpenRouter / Nous-Hermes-3, Groq, OpenAI)
GEMINI_API_KEY=your_gemini_api_key_here
PRIMARY_MODEL=gemini-2.5-flash

# Optional Cloud LLM Providers (No Ollama needed)
CLOUD_API_PROVIDER=auto
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nousresearch/hermes-3-llama-3.1-8b
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration (PostgreSQL / SQLite)
DATABASE_URL=sqlite:///data/nu_tokens.db

# Vector Database (chroma, pgvector, qdrant)
VECTOR_DB_TYPE=chroma
SIMILARITY_THRESHOLD=0.75

# Security Secrets
JWT_SECRET=nu_ai_secret_key_change_in_production_2026
MCP_AUTH_SECRET=mcp_secret_nu_2026

# Server Configuration
HOST=0.0.0.0
PORT=8080
RATE_LIMIT_PER_MINUTE=60
CRAWL_INTERVAL_HOURS=4
